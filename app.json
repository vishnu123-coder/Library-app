{
  "expo": {
    "name": "Brothers Vayanasala",
    "slug": "brothers-vayanasala-library",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "extra": { "eas": { "projectId": "4ae6132a-5f68-42ce-9184-cb369da156a3" } },
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#0A1420" },
    "ios": {
      "bundleIdentifier": "com.library.manager",
      "infoPlist": { "NSCameraUsageDescription": "Camera is used to scan book and member barcodes." },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.library.manager",
      "permissions": ["CAMERA"],
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0A1420" }
    },
    "plugins": [["expo-camera", { "cameraPermission": "Allow camera access to scan barcodes." }]]
  }
}
